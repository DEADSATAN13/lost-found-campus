# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection Strings
# Primary database (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/found_db?retryWrites=true&w=majority
# Dedicated test database (MUST contain 'test' in the database name)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/found_test

# JWT Authentication (In production, must be at least 16 random characters)
JWT_SECRET=super_secret_found_jwt_key_2026_production

# CORS allowed frontend origins (comma separated for multiple origins)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Email Delivery Configuration (Option 1: Brevo HTTPS API - Recommended for Render free tier)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
EMAIL_FROM=found@yourcampus.edu

# Email Delivery Configuration (Option 2: Gmail SMTP - Local development only)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
